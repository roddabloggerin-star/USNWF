# ===================================================================
# Standard .gitignore for a Python Weather Bot Project
# ===================================================================

# --- 1. Credentials and Secrets (NEVER COMMIT THESE!) ---
# Protect API keys, tokens, and sensitive configuration files.
# This is the most important section.
client_secrets.json
token.json
*.pem
*.key

# --- 2. Python Cache and Compiled Files ---
# Python automatically generates these and they don't belong in version control.
__pycache__/
*.py[cod]
*$py.class

# --- 3. Virtual Environments ---
# Ignore directories created by virtual environment tools.
venv/
.venv/
env/
ENV/

# --- 4. Local Output and Logs ---
# Ignore files generated by the bot for local testing and logging.
blog_posts/
*.log
weather_bot.log

# --- 5. IDE and Editor Configuration ---
# Ignore user-specific files from various code editors.
# This keeps the repository clean for collaborators.
.vscode/
.idea/
*.swp
*.swo
*~

# --- 6. Operating System Generated Files ---
# Ignore default files created by macOS and Windows.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- 7. Package Manager Files ---
# Ignore files from package managers if you decide to use them.
# (e.g., if you add a package.json file)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- 8. Jupyter Notebook Checkpoints ---
# If you use Jupyter for testing, ignore its checkpoints.
.ipynb_checkpoints

# --- 9. pytest and Coverage ---
# Ignore files generated by testing and coverage tools.
.coverage
.pytest_cache/
htmlcov/

# --- 10. Environment Variables File ---
# A common name for a local environment file.
.env
.env.local
.env.*.local
